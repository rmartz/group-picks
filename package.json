{
  "name": "group-picks",
  "version": "0.1.0",
  "description": "Collaborative group decision-making — picks, rankings, and recurring Snap Picks for groups",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest --project=node --project=hooks --project=components",
    "tsc": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook-tests": "vitest --project=storybook",
    "prepare": "husky",
    "agents:validate": "node scripts/check-agents-md.mjs",
    "docs:validate": "node scripts/validate-docs.mjs",
    "env:validate": "node scripts/validate-config.mjs",
    "pins:check": "node scripts/check-package-pins.mjs",
    "seed:debug": "node --env-file-if-exists=.env.local scripts/seed-debug-users.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "playwright",
      "protobufjs"
    ],
    "overrides": {
      "jwks-rsa>jose": "^5.10.0"
    },
    "patchedDependencies": {
      "@storybook/nextjs-vite@10.6.1": "patches/@storybook__nextjs-vite@10.6.1.patch"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@sentry/nextjs": "^11.8.0",
    "@tanstack/react-query": "^5.104.3",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "^9.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.6.2",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.22.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vercel": "^63.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
